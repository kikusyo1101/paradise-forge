{
  "model": "fable",
  "effortLevel": "xhigh",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Edit(~/.claude/**)",
      "Edit(**/.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.claude/**)"
    ],
    "ask": [
      "Bash(gh pr merge:*)"
    ],
    "allow": [
      "Bash(node graph/*)",
      "Bash(node tests/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "defaultMode": "default"
  }
}
